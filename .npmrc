save-exact=true

# The shared skill engine ships from GitHub Packages under the @a-streetcoder scope.
# Token is read from the GITHUB_TOKEN env var at install/build time (never committed);
# it needs only read:packages. End users of the packaged app need no token — the .node
# is resolved and bundled at build time.
@a-streetcoder:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
