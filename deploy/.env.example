# Agent Deck shared server settings for deploy/compose.yaml. Copy to .env next to
# compose.yaml and fill the empty values; the ones marked optional may stay empty.
# Runbook: docs/remote-server-poc.md, "Install on a server".
# The server and its agents see every variable here except TUNNEL_TOKEN.
# PORT (4200) and AGENT_DECK_TRUSTED_PROXY (cloudflare) are fixed in compose.yaml, not here:
# a wrong value would break the tunnel or turn authentication off.

# Image tag to run (for example 1.4.2). Empty runs `latest`; pin a version to make rollbacks possible.
AGENT_DECK_IMAGE_TAG=

# Cloudflare Access team domain, for example <team>.cloudflareaccess.com (Zero Trust > Settings).
AGENT_DECK_CF_ACCESS_TEAM_DOMAIN=

# Application Audience (AUD) tag of the Access application that protects the public hostname.
AGENT_DECK_CF_ACCESS_AUD=

# Public URL of the server, for example https://deck.example.com (no trailing slash).
AGENT_DECK_PUBLIC_ORIGIN=

# Optional. Client id of the GitHub OAuth App (device flow) for per-user GitHub connections. Empty: connecting answers 409.
AGENT_DECK_GITHUB_CLIENT_ID=

# Optional. Access email of the operator, whose sessions keep the shared ~/.pi/agent. Empty: every user gets an own agent dir.
AGENT_DECK_OPERATOR_EMAIL=

# Folder for shared-project clones and the server folder browser. Keep it inside /data so clones persist.
AGENT_DECK_PROJECT_ROOT=/data/projects

# Optional gh binary override. Empty uses the gh the image ships on PATH.
AGENT_DECK_GH_BIN=

# Token of the Cloudflare tunnel (Zero Trust > Networks > Tunnels > the tunnel > install command). Read by cloudflared only.
TUNNEL_TOKEN=
