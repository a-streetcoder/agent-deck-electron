{
  "name": "@agent-deck/skill-engine-native",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "napi": {
    "binaryName": "skill-engine-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "prebuild": "node scripts/clean-native.mjs",
    "build": "napi build --release --platform --output-dir native && node scripts/verify-native.mjs",
    "build:debug": "napi build --platform --output-dir native",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --locked"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.4",
    "@types/node": "22.15.29"
  }
}
