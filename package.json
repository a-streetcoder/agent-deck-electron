{
  "name": "agent-deck-electron",
  "private": true,
  "version": "0.0.1",
  "main": "apps/desktop/main.js",
  "description": "Cross-platform Agent Deck: Node/TypeScript core + web UI on top of the pi coding agent",
  "author": "StreetCoding Ltd",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "pnpm build:native",
    "dev": "pnpm --filter @agent-deck/desktop dev",
    "dev:onboarding-empty": "node scripts/dev-onboarding-empty.mjs",
    "build:native": "pnpm --filter @agent-deck/loop-catalog-native build && pnpm --filter @agent-deck/loop-catalog-native smoke",
    "build": "pnpm build:native && pnpm build:web && pnpm build:backend && pnpm build:pi-runtime",
    "build:web": "pnpm --filter @agent-deck/web build",
    "build:backend": "node scripts/build-backend.mjs",
    "build:pi-runtime": "node scripts/build-pi-runtime.mjs",
    "smoke:packaged-native": "node scripts/smoke-packaged-loop-catalog.mjs release",
    "generate:icons": "bash scripts/generate-icons.sh",
    "pack:mac": "pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 -c.mac.notarize=false -c.mac.hardenedRuntime=false",
    "release:mac": "pnpm build && electron-builder --mac dmg --arm64",
    "validate:mac": "bash scripts/validate-macos-release.sh",
    "demo:chat": "tsx packages/testkit/demo/chat.ts",
    "typecheck": "pnpm -r --parallel typecheck",
    "pretest": "pnpm build:native",
    "test": "pnpm -r test",
    "pretest:pi": "pnpm build:native",
    "test:pi": "pnpm -r --filter '!@agent-deck/e2e' test:pi",
    "test:e2e": "pnpm --filter @agent-deck/e2e test:pi",
    "check:design-system": "node scripts/check-design-system.mjs",
    "lint": "pnpm check:design-system && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.30.0",
    "cross-env": "10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "9.30.0",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  }
}
